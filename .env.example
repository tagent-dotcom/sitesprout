# Copy to .env for local work. In Vercel, add the same names under
# Project Settings > Environment Variables. Anything empty is simply skipped.

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
PUBLIC_GA_ID=
# Microsoft Clarity project id (free heatmaps and recordings), e.g. abcd1234ef
PUBLIC_CLARITY_ID=
# Google Search Console "HTML tag" verification code (only the content value)
PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools "meta tag" verification code (only the content value)
PUBLIC_BING_VERIFICATION=
# Whop plan id for the paid product, e.g. plan_XXXXXXXXXXXX (leave empty to hide all paid UI)
PUBLIC_WHOP_PLAN_ID=
# IndexNow key (create one with: npm run indexnow:key)
INDEXNOW_KEY=
