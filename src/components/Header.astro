---
import { SITE } from '../config/site';
import type { Locale } from '../i18n/config';
import { pathFor, type PageKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';

interface Props { lang: Locale; page?: PageKey }
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const nav: [PageKey, Parameters<typeof t>[0]][] = [['about', 'nav.about'], ['pricing', 'nav.pricing'], ['contact', 'nav.contact']];
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={pathFor('home', lang)}>{SITE.name}</a>
    <nav aria-label="Main">
      {nav.map(([key, label]) => (
        <a href={pathFor(key, lang)} aria-current={page === key ? 'page' : undefined}>{t(label)}</a>
      ))}
    </nav>
    <LangSwitcher lang={lang} page={page} />
  </div>
</header>
