---
/**
 * Language menu: the current flag on the button, every language with its
 * name inside. Each option links to the same page in that language, or to
 * that language's home when the page is not translated yet, so a click
 * never lands on a 404. Built on <details>, so it works without JavaScript.
 */
import { LOCALES, LOCALE_CODES, type Locale } from '../i18n/config';
import { pathFor, type PageKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props { lang: Locale; page?: PageKey }
const { lang, page = 'home' } = Astro.props;
const t = useTranslations(lang);
---

{LOCALE_CODES.length > 1 && (
  <details class="lang">
    <summary aria-label={`${t('lang.label')}: ${LOCALES[lang].label}`}>
      <span aria-hidden="true">{LOCALES[lang].flag}</span>
      <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M5.2 7.2a.75.75 0 0 1 1.1 0L10 11.2l3.7-4a.75.75 0 1 1 1.1 1l-4.2 4.6a.75.75 0 0 1-1.1 0L5.2 8.3a.75.75 0 0 1 0-1.1z" /></svg>
    </summary>
    <ul>
      {LOCALE_CODES.map((code) => (
        <li>
          <a href={pathFor(page, code)} hreflang={LOCALES[code].htmlLang} lang={LOCALES[code].htmlLang} aria-current={code === lang ? 'true' : undefined}>
            <span aria-hidden="true">{LOCALES[code].flag}</span> {LOCALES[code].label}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

<script>
  // Close on Escape or a click outside.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.lang[open]').forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('details.lang[open]').forEach((d) => (d.open = false));
  });
</script>
